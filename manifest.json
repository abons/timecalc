{
  "manifest_version": 3,
  "name": "Timecalc",
  "version": "1.1.3",
  "description": "Bereken je werktijd en log de eerste interactie per dag.",
  "action": {
    "default_title": "Timecalc"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "webNavigation",
    "sidePanel"
  ],
  "content_scripts": [
    {
      "matches": ["https://monitor.yoobi.nl/*"],
      "js": ["monitor-yoobi/content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://monitor.yoobi.nl/*"],
      "js": ["monitor-yoobi/page-world.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "host_permissions": [
    "https://api.github.com/*",
    "https://*.atlassian.net/*",
    "https://monitor.yoobi.nl/*",
    "https://e-dynamicsbv.yoobi.nl/*"
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
